# Copy to .env.local for local development. In production these are set in
# the Vercel project; instrumentation.ts refuses to start a production server
# when a required value is missing or invalid (see src/server/env.ts).

# --- Required in production ---

# Public origin of the web app, e.g. https://splittrip.example.com.
# Used as the better-auth base URL, a trusted origin, and in email links.
# Inlined into the client bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso/libSQL database. Local development may use file:./dev.db;
# a file: URL is rejected on Vercel.
TURSO_DATABASE_URL=
# Required whenever TURSO_DATABASE_URL is a remote (libsql://) database.
TURSO_AUTH_TOKEN=

# Signs session cookies. At least 32 characters. Changing it logs every user
# out, so keep the value identical across deploys.
BETTER_AUTH_SECRET=

# --- Recommended ---

# Without an API key, password reset and invitation emails are skipped.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- Optional ---

# Comma-separated extra origins allowed to call /api (e.g. a custom domain
# alongside the *.vercel.app URL). Also trusted by better-auth.
ALLOWED_ORIGINS=

# Auth requests allowed per IP per minute (default 20).
AUTH_RATE_LIMIT_MAX=

# Only for debugging; disables better-auth's origin check.
DISABLE_ORIGIN_CHECK=

# Sentry error reporting (errors are only sent in production builds).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
